# StockRoom AUT (local default matches StockRoom README)
STOCKROOM_BASE_URL=http://127.0.0.1:43124

# Required when hitting the protected Vercel AUT
# VERCEL_AUTOMATION_BYPASS_SECRET=

# ── LLM generation (npm run generate) ───────────────────────────────
# Set one of these. LLM_API_KEY is preferred; provider-specific keys work too.
# LLM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
#
# LLM_PROVIDER=openai          # or anthropic
# LLM_MODEL=gpt-4o-mini        # openai default; for anthropic e.g. claude-sonnet-4-20250514
# REQUIRE_LLM=false            # set true to fail instead of writing offline stub

# Path to sibling RestAssured-BDD project (for npm run test:api / sync:features)
RESTASSURED_DIR=../RestAssured-BDD

# Optional Cucumber tag override for test:api
# CUCUMBER_FILTER_TAGS=@smoke and @stockroom
