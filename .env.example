# StockRoom AUT
# Local:
STOCKROOM_BASE_URL=http://127.0.0.1:43124
# Hosted (CI / Vercel) — also set as GitHub Actions Variable via:
#   ./scripts/setup-github-ci-env.sh
# STOCKROOM_BASE_URL=https://stock-room-ashishraj-tyagi.vercel.app

# Required when hitting the protected Vercel AUT (local smoke + CI secret)
# Copy from Vercel → Project → Settings → Deployment Protection →
#   Protection Bypass for Automation
# Then: ./scripts/setup-github-ci-env.sh
# VERCEL_AUTOMATION_BYPASS_SECRET=

# ── LLM generation (npm run generate) ───────────────────────────────
# Set one of these. LLM_API_KEY is preferred; provider-specific keys work too.
# LLM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
#
# LLM_PROVIDER=openai          # or anthropic
# LLM_MODEL=gpt-4o-mini        # openai default; for anthropic e.g. claude-sonnet-4-20250514
# REQUIRE_LLM=false            # set true to fail instead of writing offline stub

# Explore / contract
# EXPLORE_MAX_STEPS=12
# EXPLORE_TIMEOUT_MS=20000
# CONTRACT_FAIL_ON_BREAKING=false

# Path to sibling RestAssured-BDD project (for npm run test:api / sync:features)
RESTASSURED_DIR=../RestAssured-BDD

# Optional Cucumber tag override for test:api
# CUCUMBER_FILTER_TAGS=@smoke and @stockroom
