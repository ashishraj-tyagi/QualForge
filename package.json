{
  "name": "qualforge",
  "version": "0.2.0",
  "private": true,
  "description": "AI-assisted test design with human-in-the-loop guardrails, executed against StockRoom in CI",
  "type": "module",
  "scripts": {
    "ingest": "tsx src/ingest/openapi.ts",
    "generate": "tsx src/generate/llm.ts",
    "guardrails": "tsx src/guardrails/index.ts",
    "review:list": "tsx src/review/list.ts",
    "approve": "tsx src/review/approve.ts",
    "summarize": "tsx src/summarize/release.ts",
    "sync:features": "node scripts/sync-features.mjs",
    "setup:ci-env": "bash scripts/setup-github-ci-env.sh",
    "pipeline:draft": "npm run ingest && npm run generate && npm run guardrails",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:smoke": "tsx scripts/smoke-stockroom.ts",
    "dashboard": "tsx src/quality/cli.ts",
    "explore": "tsx src/explore/agent.ts",
    "contract:diff": "tsx src/contract/diff.ts",
    "allure:generate": "npx --yes allure-commandline@2.46.1 generate allure-results -o allure-report --clean",
    "allure:open": "npx --yes allure-commandline@2.46.1 open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
